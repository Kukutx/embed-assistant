# HTTPS certificates are obtained and renewed automatically for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy server:8787 {
		# Stream answers (Server-Sent Events) without buffering.
		flush_interval -1
	}
}

# Other sites on this server (one file per site, e.g. sites/www.caddy); reload with
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
import /etc/caddy/sites/*.caddy
