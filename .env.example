# Copy to .env (scripts/quickstart.sh does this and fills SECRET_KEY for you).

# Required: root secret (>= 32 chars). Session tokens and stored widget secrets derive from it.
SECRET_KEY=
# Public URL of this server (used in embed snippets).
PUBLIC_BASE_URL=http://localhost:8787

# --- Models (configure any; aliases fail over in order; the offline "extractive" mode is always last) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (Azure, vLLM, LiteLLM, LM Studio...)
# OPENAI_MODEL=gpt-5-mini
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2
# Full control instead of the variables above: MODELS_CONFIG=/app/config/models.json (see config/models.example.json)

# --- Embeddings (optional; enables semantic + cross-language search) ---
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Limits ---
# RATE_LIMIT_RUNS_PER_MINUTE=10
# RATE_LIMIT_RUNS_PER_HOUR_IP=600
# RATE_LIMIT_SESSIONS_PER_HOUR_IP=300
# DEFAULT_DAILY_TOKEN_BUDGET=2000000

# --- Operations ---
# LOG_LEVEL=info
# TRUST_PROXY=false           # true only behind a reverse proxy you control
# METRICS_TOKEN=              # protect /metrics with a bearer token
# SERVE_CONSOLE=true          # /admin and /demo
# RUN_WORKER=true             # background crawler in this process

# Actions and webhooks may call private/internal addresses (default: blocked).
# OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
# Delete conversations older than N days (0 = keep). Tenants can override in the console.
# DEFAULT_RETENTION_DAYS=0
