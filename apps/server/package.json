{
  "name": "@embed-assistant/server",
  "version": "1.0.0",
  "private": true,
  "description": "embed-assistant API server: sessions, conversations, streaming runs, knowledge, model routing.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@embed-assistant/protocol": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "node-html-parser": "^9.0.7",
    "pino": "^10.0.0",
    "postgres": "^4.1.1",
    "undici": "^8.12.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "migrations",
    "static"
  ],
  "main": "dist/main.js"
}
