{
  "name": "@embed-assistant/server",
  "version": "1.0.13",
  "private": true,
  "description": "embed-assistant API server: sessions, conversations, streaming runs, knowledge, model routing.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "test": "vitest run",
    "rotate-secrets": "tsx src/cli/rotateSecrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@embed-assistant/protocol": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "mammoth": "1.13.0",
    "node-html-parser": "^7.0.1",
    "pino": "^10.0.0",
    "postgres": "^3.4.7",
    "undici": "^7.30.2",
    "unpdf": "2.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "migrations",
    "static"
  ],
  "main": "dist/main.js"
}
